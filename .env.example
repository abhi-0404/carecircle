# Copy to .env and fill in. .env is git-ignored: never commit keys.

# Your Switch server. Switch Console's local server listens here by default.
SWITCH_URL=http://127.0.0.1:55618

# Switch Console > Settings > API keys > "Create registration key".
SWITCH_REGISTRATION_KEY=paste-your-registration-key-here

# Filled in by `uv run carecircle-ledger register`.
LEDGER_AGENT_ID=
LEDGER_API_KEY=
